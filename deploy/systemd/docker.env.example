# Deployment paths for deploy/systemd/issue-orchestrator-docker.service.
# Copy to /etc/issue-orchestrator/docker.env, keep root-owned and mode 0600.
# This file contains paths only. Never put tokens, passwords, or key material
# here or in the unit file; mount provider credentials read-only instead.
ISSUE_ORCHESTRATOR_WORKSPACE=/srv/issue-orchestrator/workspace
ISSUE_ORCHESTRATOR_CONFIG_FILE=/srv/issue-orchestrator/config.jsonc
OPENCODE_CONFIG=/srv/issue-orchestrator/opencode.jsonc
OPENCODE_DATA_DIR=/srv/issue-orchestrator/opencode-data
GH_CONFIG_DIR=/srv/issue-orchestrator/gh
ISSUE_ORCHESTRATOR_RUNTIME_BIN=/srv/issue-orchestrator/runtime-bin
# ISSUE_ORCHESTRATOR_MODE=router
# ISSUE_ORCHESTRATOR_PROJECT=owner/repository
# ISSUE_ORCHESTRATOR_MAX=1000
# ISSUE_ORCHESTRATOR_INTERVAL_SECONDS=300
