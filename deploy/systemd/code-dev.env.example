# Non-secret container paths for
# deploy/systemd/issue-orchestrator-code-dev.service.
#
# Copy to /etc/issue-orchestrator/code-dev.env, keep it root-owned and mode
# 0600. Every value is a path or identifier inside the already-running code-dev
# container. Never put tokens, passwords, auth files or key material here; the
# container's existing gh and OpenCode volumes are used directly.
#
# The durable state directory lives in the container's existing persistent
# OpenCode state volume (dev-vm_opencode-state). Do not point it at
# /home/dev/.config or another container-layer path: adding a new mount would
# require recreating code-dev.

ISSUE_ORCHESTRATOR_CONTAINER=code-dev
ISSUE_ORCHESTRATOR_CONTAINER_USER=dev
ISSUE_ORCHESTRATOR_CHECKOUT=/projects/issue-orchestrator
ISSUE_ORCHESTRATOR_WORKSPACE=/projects/issue-orchestrator-github-integration
ISSUE_ORCHESTRATOR_STATE_DIR=/home/dev/.local/state/opencode/issue-orchestrator
ISSUE_ORCHESTRATOR_CONFIG=/home/dev/.local/state/opencode/issue-orchestrator/config.jsonc
ISSUE_ORCHESTRATOR_GH_CONFIG_DIR=/home/dev/.config/gh
ISSUE_ORCHESTRATOR_OPENCODE_CONFIG=/home/dev/.config/opencode/opencode.jsonc
ISSUE_ORCHESTRATOR_OPENCODE_DATA_DIR=/home/dev/.local/share/opencode
ISSUE_ORCHESTRATOR_INTERVAL_SECONDS=300
ISSUE_ORCHESTRATOR_MAX=1000

# Required only when legacy state exists and the durable database is absent.
# Set "migrated" after copying the old SQLite state, or "fresh" to explicitly
# accept an empty durable queue. Preflight refuses to start otherwise.
# ISSUE_ORCHESTRATOR_STATE_DECISION=migrated

# Optional:
# ISSUE_ORCHESTRATOR_PROJECT=owner/repository
# ISSUE_ORCHESTRATOR_START_TIMEOUT_SECONDS=180
# Keep the stop timeout below the unit's TimeoutStopSec=330.
# ISSUE_ORCHESTRATOR_STOP_TIMEOUT_SECONDS=300
# ISSUE_ORCHESTRATOR_LEGACY_CONFIG=/home/dev/.config/issue-orchestrator/config.jsonc
