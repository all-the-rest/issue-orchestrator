{
  "name": "@all-the.rest/issue-orchestrator",
  "version": "0.0.0",
  "description": "Provider-independent CLI that turns trusted issues into reviewed, evidenced change requests. Deterministic orchestration, OpenCode as the first agent backend.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "issue-orchestrator": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node test/e2e.mjs && node test/persistence.mjs",
    "prepack": "pnpm build",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
