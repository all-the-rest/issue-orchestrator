{
  "name": "@all-the.rest/issue-orchestrator",
  "version": "0.0.0",
  "description": "GitHub-only trusted event router for persistent OpenCode ticket-agent chats; the legacy workflow remains available.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "issue-orchestrator": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prototype:sdk-host-recovery": "node prototype/sdk-host-recovery.mjs",
    "test": "pnpm lint && pnpm build && node test/run-parallel.mjs",
    "prepack": "pnpm build",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/sdk": "2.2.6",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
